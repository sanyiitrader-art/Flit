<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Storage. API 28-29: legacy runtime permissions. API 30+: all-files access (Settings screen, not a runtime dialog). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Apps tab: list installed applications on Android 11+. Also lets Flit check that an app exists for "Open with". -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Installing received APKs. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Wi-Fi Direct. API 28-32: Location. API 33+: Nearby Wi-Fi Devices (never used for location). -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required by Android to create TCP sockets. Flit never uses the internet for transfers. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notifications and background operation. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Audio keeps playing in the background; archive extraction keeps running when hidden. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <application
        android:name=".FlitApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flit"
        tools:ignore="DataExtractionRules">

        <!-- Portrait by default; the video player unlocks rotation while it is open.
             supportsPictureInPicture: native system PiP for the video player (no overlay permission). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with": every format Flit opens itself (viewers, players, extraction). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/bmp" />
                <data android:mimeType="image/x-ms-bmp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
                <data android:mimeType="image/avif" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="video/mp4" />
                <data android:mimeType="video/3gpp" />
                <data android:mimeType="video/3gpp2" />
                <data android:mimeType="video/webm" />
                <data android:mimeType="video/x-matroska" />
                <data android:mimeType="video/quicktime" />
                <data android:mimeType="video/mpeg" />
                <data android:mimeType="video/mp2t" />
                <data android:mimeType="video/mp2ts" />
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/mp3" />
                <data android:mimeType="audio/mp4" />
                <data android:mimeType="audio/aac" />
                <data android:mimeType="audio/x-aac" />
                <data android:mimeType="audio/x-wav" />
                <data android:mimeType="audio/wav" />
                <data android:mimeType="audio/flac" />
                <data android:mimeType="audio/x-flac" />
                <data android:mimeType="audio/ogg" />
                <data android:mimeType="audio/opus" />
                <data android:mimeType="audio/amr" />
                <data android:mimeType="audio/3gpp" />
                <data android:mimeType="audio/x-matroska" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar" />
            </intent-filter>

            <!-- "Open with" for files whose type the other app does not name: match by extension. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.markdown" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\.7z" />
                <data android:pathPattern=".*\\.rar" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\.heic" />
                <data android:pathPattern=".*\\.avif" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.txt" />
            </intent-filter>

            <!-- "Share": send one or several files with Flit. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Keeps Receiver mode and running transfers alive in the background. -->
        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Background audio playback and archive extraction (one small service for both). -->
        <service
            android:name=".BgService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|dataSync" />

        <!-- Receives the result of a split-APK install session (Android's own confirmation screen). -->
        <receiver
            android:name=".InstallResult"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
